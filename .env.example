# ==============================================================================
# SAHELI — Environment Configuration Template
# Copy this file to .env and configure for your deployment environment
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Security & Session Secrets (Must be set to high-entropy 64+ char random string)
JWT_SECRET=saheli-super-secret-key-change-in-production-must-be-high-entropy-64-bytes

# Database Configuration
# Default uses local embedded SQLite WAL database: database/saheli.db
DATABASE_PATH=database/saheli.db

# CORS Configuration
CORS_ORIGIN=https://saheli-safety.org,http://localhost:5173

# Rate Limiting
RATE_LIMIT_GENERAL=120
RATE_LIMIT_AUTH=10

# Email Delivery Configuration (Supports 'resend', 'smtp', or 'sendgrid')
EMAIL_PROVIDER=resend
EMAIL_FROM=SAHELI Safety <onboarding@resend.dev>
APP_URL=http://localhost:5173
API_URL=http://localhost:5000

# Resend API Key (Recommended, free tier: https://resend.com)
RESEND_API_KEY=

# Standard SMTP Alternative (Gmail, Brevo, AWS SES)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Optional Strict Email Verification for Protected Login
# ENFORCE_VERIFIED_LOGIN=false

# Optional Google Maps Embed API (Frontend Preview)
# Restrict in Google Cloud Console by HTTP referrer
VITE_GOOGLE_MAPS_EMBED_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Supabase Auth Email OTP & Verified Registry Configuration
# Frontend environment keys (Safe for browser):
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key

# Backend server environment keys (Kept strictly server-side):
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# SUPABASE DASHBOARD EMAIL OTP CONFIGURATION GUIDE:
# 1. Sign up / Open project at: https://supabase.com/dashboard/project/<project-ref>
# 2. Go to: Authentication -> Providers -> Email
#    - Enable Email Provider: ON
#    - Confirm Email: ON
#    - Secure email change: ON
# 3. Go to: Authentication -> Email Templates -> Confirmation / Magic Link
#    - In the email body, replace the link with the 6-digit OTP token placeholder:
#      <h2>Your SAHELI Verification Code is: {{ .Token }}</h2>
#      <p>This 6-digit code is valid for 5 minutes. Do not share it with anyone.</p>
# 4. Go to: Authentication -> Rate Limits / Protection
#    - Email OTP Expiry: Set to 300 seconds (5 minutes)
#    - Max resend frequency: 60 seconds
# 5. Go to: Project Settings -> Authentication -> SMTP Settings
#    - Enable Custom SMTP for high-deliverability production email dispatch
# ------------------------------------------------------------------------------

# NOTE: The primary mapping engine (Leaflet + OpenStreetMap), Geocoding (Nominatim),
# Nearby Facility Discovery (Overpass QL), Routing (Project-OSRM), and Live Weather (Open-Meteo)
# operate at ZERO COST with no mandatory paid API keys or subscriptions.
